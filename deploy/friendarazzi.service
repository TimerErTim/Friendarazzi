[Unit]
Description=Friendarazzi production Compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/friendarazzi/repo
ExecStart=/usr/bin/docker compose --project-directory /opt/friendarazzi/repo -f /opt/friendarazzi/repo/compose.yaml --env-file /opt/friendarazzi/.env --env-file /opt/friendarazzi/state/deploy.env up -d --remove-orphans
ExecStop=/usr/bin/docker compose --project-directory /opt/friendarazzi/repo -f /opt/friendarazzi/repo/compose.yaml --env-file /opt/friendarazzi/.env --env-file /opt/friendarazzi/state/deploy.env stop
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
